# ================== 名称获取 ==================
def get_all_etf_names():
    """获取全市场ETF代码->名称映射（东方财富源）"""
    try:
        print("正在获取全市场ETF名称列表...")
        df = ak.fund_etf_spot_em()
        name_dict = dict(zip(df['代码'], df['名称']))
        print(f"成功获取 {len(name_dict)} 只ETF名称")
        return name_dict
    except Exception as e:
        print(f"获取ETF名称列表失败: {e}")
        return {}

# ================== akshare 数据获取 ==================
def get_etf_daily_akshare(symbol, start_date, end_date, name_dict=None):
    """
    使用 akshare 的 fund_etf_hist_em 获取 ETF 日线数据（自上市日起）
    """
    base_code = symbol.replace(".SH", "").replace(".SZ", "")
    fund_name = name_dict.get(base_code, symbol) if name_dict else symbol

    try:
        df = ak.fund_etf_hist_em(
            symbol=base_code,
            period="daily",
            start_date=start_date,
            end_date=end_date,
            adjust="qfq"
        )
        if df.empty:
            print(f"  akshare 返回 {symbol} 数据为空")
            return pd.DataFrame(), fund_name

        print(f"  akshare 获取 {symbol} 成功，共 {len(df)} 条记录")
        return df, fund_name

    except Exception as e:
        print(f"  akshare 获取 {symbol} 失败: {e}")
        return pd.DataFrame(), fund_name

# ================== 数据清洗与标准化 ==================
def transform_to_standard(raw_df, symbol, fund_name):
    """
    将原始DataFrame转换为统一输出格式，包含换手率，无市值列
    """
    if raw_df.empty:
        return raw_df

    df = raw_df.copy()

    # 所需列映射（包含换手率）
    required_columns = {
        '日期': 'date',
        '开盘': 'open',
        '收盘': 'close',
        '最高': 'high',
        '最低': 'low',
        '成交量': 'volume',
        '成交额': 'amount',
        '换手率': 'turnover'
    }
    missing = [col for col in required_columns if col not in df.columns]
    if missing:
        print(f"警告：{symbol} 缺少列 {missing}，跳过")
        return pd.DataFrame()

    df = df[list(required_columns.keys())].rename(columns=required_columns)

    # 日期处理
    df['date'] = pd.to_datetime(df['date'])
    df = df.sort_values('date').reset_index(drop=True)

    # 数值转换
    for col in ['open', 'high', 'low', 'close', 'volume', 'amount', 'turnover']:
        df[col] = pd.to_numeric(df[col], errors='coerce')

    # 计算前收盘价
    df['pre_close'] = df['close'].shift(1).fillna(0)

    # 添加股票信息（无市值列）
    df['stock_code'] = symbol
    df['stock_name'] = fund_name

    # 重命名为最终中文列名
    final_df = df.rename(columns={
        'date': '交易日期',
        'open': '开盘价',
        'high': '最高价',
        'low': '最低价',
        'close': '收盘价',
        'pre_close': '前收盘价',
        'volume': '成交量',
        'amount': '成交额',
        'turnover': '换手率',
        'stock_code': '股票代码',
        'stock_name': '股票名称'
    })


    column_order = ['股票代码', '股票名称', '交易日期', '开盘价', '最高价', '最低价',
                    '收盘价', '前收盘价', '成交量', '成交额', '换手率']
    return final_df[column_order]

def save_to_csv(df, symbol):
    """保存 DataFrame 到 CSV 文件"""
    if df.empty:
        print(f"警告：{symbol} 无数据，未生成文件")
        return
    filename = f"{symbol}.csv"
    filepath = os.path.join(OUTPUT_DIR, filename)
    df.to_csv(filepath, index=False, encoding='utf-8-sig')
    print(f"已保存：{filepath}，共 {len(df)} 条记录")

# ================== 主程序 ==================
def main():
    print(f"开始处理 {len(TARGET_STOCK_LIST)} 只基金，日期范围：{START_DATE} 至 {END_DATE}")


    name_dict = get_all_etf_names()

    success_count = 0
    fail_list = []

    for i, symbol in enumerate(TARGET_STOCK_LIST, 1):
        print(f"\n[{i}/{len(TARGET_STOCK_LIST)}] 正在处理 {symbol} ...")

        raw_df, fund_name = get_etf_daily_akshare(symbol, START_DATE, END_DATE, name_dict)

        if raw_df.empty:
            print(f"{symbol} 获取数据为空，加入失败列表")
            fail_list.append(symbol)
            continue

        std_df = transform_to_standard(raw_df, symbol, fund_name)
        if std_df.empty:
            print(f"{symbol} 清洗后无数据，加入失败列表")
            fail_list.append(symbol)
            continue

        save_to_csv(std_df, symbol)
        success_count += 1

        if i % 10 == 0:
            print(f"\n已处理 {i} 只，暂停 5 秒...")
            time.sleep(5)

    print(f"\n{'='*40}")
    print(f"处理完成！成功：{success_count} 只，失败：{len(fail_list)} 只")
    if fail_list:
        print(f"失败基金列表：{fail_list}")
        print("你可以稍后单独重试这些基金（可能因成立时间晚或无数据）")

if __name__ == "__main__":
    time.sleep(2)
    main()
